# Anahtarı buraya yazma; ortam değişkeni olarak ver: export EVREN_API_KEY=...
# Aşağıdakiler isteğe bağlı ayarlardır (varsayılanlar config.py içinde).
MEDRAG_DATA_DIR=data
MEDRAG_INDEX_DIR=data/index_qwen3
MEDRAG_TOP_K=5
MEDRAG_EMBED_API_URL=https://evren-llmapi.ssyz.org.tr/v1
MEDRAG_EMBED_API_MODEL=qwen3-embedding-8b
MEDRAG_EMBED_DIMENSIONS=1024
MEDRAG_LLM_API_URL=https://evren-llmapi.ssyz.org.tr/v1
MEDRAG_LLM_MODEL=auto
